{
  "name": "cmumc-web",
  "description": "Carnegie Mellon's Minecraft Multiplayer Server site.",
  "private": true,
  "scripts": {
    "build": "bundle exec jekyll build",
    "serve": "bundle exec jekyll serve --livereload",
    "check": "npm run format:check && npm run validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "html-validate \"_site/**/*.html\""
  },
  "devDependencies": {
    "@j178/prek": "^0.5.7",
    "html-validate": "^11.17.0",
    "prettier": "^3.9.10"
  }
}
